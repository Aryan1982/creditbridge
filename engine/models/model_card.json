 "version": "2.0",
 "data": {
  "description": "Synthetic Indian bank/UPI statements from a persona-based simulator (salaried, gig workers, shopkeepers, farmers, students, homemakers) with bank-specific narration formats (SBI, HDFC, ICICI, Axis, Kotak, Canara, Bank of Baroda, PNB), truncation and typos.",
  "n_applicants": 6000,
  "n_transactions": 2852088,
  "synthetic": true,
  "default_rate": 0.2018,
  "default_rate_by_persona": {
   "farmer": 0.2616,
   "gig_worker": 0.2284,
   "homemaker": 0.1791,
   "salaried": 0.1396,
   "shopkeeper": 0.2035,
   "student": 0.2128
  },
  "history_months": "6–12 per applicant",
  "simulator_notes": [
   "Hidden traits (money discipline, repayment priority, income-shock risk, liquidity stress, betting and loan-app propensity) drive what appears in the statement: bill timing, NACH/ECS bounces with return charges, minimum-balance penalties, instant-loan-app borrowing, betting, savings and balances.",
   "Default is simulated over a separate future 12-month window from the hidden traits plus fresh income shocks and individual noise, so it is not a deterministic function of statement features.",
   "Default rates are calibrated per persona (≈14–26%); gender is simulated only for the fairness audit.",
   "Categorizer corpus and risk population use disjoint simulator seeds."
  ]
 },
